# User configuration: ~/.codex/config.toml
# Full local and network access is intentional.
sandbox_mode = "danger-full-access"
approval_policy = "never"

model = "gpt-6-sol"
model_reasoning_effort = "low"
plan_mode_reasoning_effort = "high"
model_reasoning_summary = "none"
model_verbosity = "low"
    
# General sessions can search the OpenAI-maintained index. Use --search when
# current pages and recent papers matter.
web_search = "cached"
service_tier = "default"
tool_output_token_limit = 6000

personality = "pragmatic"
cli_auth_credentials_store = "file"

developer_instructions = '''{{GLOBAL_INSTRUCTIONS}}'''

[features]
# Avoid higher-credit fast-tier selection and automatic background continuation.
fast_mode = false
goals = false

# Disable automatic cross-session memory processing to avoid extra context and
# model work. Re-enable explicitly if durable Codex memory is desired.
memories = false

[agents]
# Keep subagents available, but bound fan-out and use a cheaper supporting model.
max_concurrent_threads_per_session = 2
default_subagent_model = "gpt-5.6-terra"
default_subagent_reasoning_effort = "medium"

[plugins."superpowers@openai-curated"]
enabled = true

[plugins."github@openai-curated"]
enabled = true

# Re-inject a one-line gate summary on every prompt. Codex asks to trust this
# hook once. Review it with /hooks.
[[hooks.UserPromptSubmit]]

[[hooks.UserPromptSubmit.hooks]]
type = "command"
command = 'echo "Follow the global instructions. Classify the request, apply its gate: code/debug=Superpowers, even small edits. Plots=Superpowers+scientific-plot-maker. Research=no Superpowers. Papers=scribe. README=readmaker. Docs=docs/ folder. Every test script you write (implementation, debugging, any) goes in tests/agents/<area>/, unless the user names another path. Only if asked: ingest=ingest-context, handoff=session-handoff."'
command_windows = 'Write-Output "Follow the global instructions. Classify the request, apply its gate: code/debug=Superpowers, even small edits. Plots=Superpowers+scientific-plot-maker. Research=no Superpowers. Papers=scribe. README=readmaker. Docs=docs/ folder. Every test script you write (implementation, debugging, any) goes in tests/agents/<area>/, unless the user names another path. Only if asked: ingest=ingest-context, handoff=session-handoff."'
timeout = 5

[tui]
pet = "codex"
status_line = ["model-with-reasoning", "context-used", "five-hour-limit", "weekly-limit"]
status_line_use_colors = true

[notice]
hide_full_access_warning = true
hide_rate_limit_model_nudge = false
